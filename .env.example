# 把这个文件复制成 .env，然后填上你自己的值。
#
#   copy .env.example .env
#
# ⚠️ .env 已被 .gitignore 排除，绝不会提交。
#    这个 .env.example 是可以提交的（里面没有真实密钥）。

# ===== 必填 =====

# 你的 API Key（从厂商后台复制）
API_KEY=

# 服务地址。★ 国内厂商大多要带 /v1
#   DeepSeek   https://api.deepseek.com/v1
#   通义千问    https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM    https://open.bigmodel.cn/api/paas/v4
#   月之暗面    https://api.moonshot.cn/v1
#   硅基流动    https://api.siliconflow.cn/v1
#   本地 vLLM   http://127.0.0.1:8000/v1     ← 用 4.17 节部署的模型时
#   本地 Ollama http://127.0.0.1:11434/v1    ← Ollama 的 OpenAI 兼容接口
BASE_URL=

# 模型名。★ 一字不差，大小写敏感
#   deepseek-chat / deepseek-reasoner
#   qwen-plus / qwen-turbo
#   glm-4-flash
#   moonshot-v1-8k
MODEL=


# ===== 可选（本地部署时才用，见手册 4.17）=====

# 本地 vLLM 为了省事，Key 随便填一个非空字符串即可
# API_KEY=sk-local
